# PondMerge v1 on-target acceptance firmware.
#
# This file carries the ESP32-S3 defaults and is the one a plain `idf.py build`
# uses, so the S3 path is unchanged from before the second target was added.
#
# A different target is selected by pointing SDKCONFIG_DEFAULTS at this file AND
# at its own, because ESP-IDF does not read sdkconfig.defaults.<target> by itself
# (verified in tools/cmake/project.cmake) and because a second file cannot
# override CONFIG_IDF_TARGET from the defaults list -- IDF guesses the target with
# a first-match rule, so `idf.py set-target` is what actually switches it:
#
#   rm -f sdkconfig && \
#   SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.esp32" \
#       idf.py set-target esp32 build
#
# The classic ESP32 entry point does not run the acceptance suite; it cannot,
# because the suite pins its zone to 64 segments inside its own assertions. See
# esp32/main/CMakeLists.txt and esp32/sdkconfig.defaults.esp32.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n
CONFIG_MAIN_TASK_STACK_SIZE=16384

# v20: the fixture zone shrank to 64 KiB (1 KiB segments), so the acceptance
# firmware fits static DRAM again -- no PSRAM is required for the suite. The
# PM_ZONE_ATTR plumbing stays available (see tests/suite.cpp) for integrations
# that want the zone elsewhere.
